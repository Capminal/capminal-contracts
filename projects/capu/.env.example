# Copy to .env and fill in your own values. NEVER commit a real .env.
# RPC endpoint for the target network
RPC_URL=
# Deployer private key (0x-prefixed). Use a dedicated deploy key, never a personal wallet.
PRIVATE_KEY=
# Block explorer API key for contract verification
ETHERSCAN_API_KEY=
# Admin address that receives DEFAULT_ADMIN_ROLE on the proxies
ADMIN=
